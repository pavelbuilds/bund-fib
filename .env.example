# Copy this file to .env.local for local development.
# On Vercel, set these under Project Settings → Environment Variables.

# Gmail app password for bundfib.webseite@gmail.com.
# Used by app/api/contactForm/route.js to send contact form submissions
# to verwaltung@bund-fib.de. Create one at https://myaccount.google.com/apppasswords
EMAIL_PW=

# Optional: overrides the Google Maps Embed API key used in
# components/ContactPersonCard.jsx (a default key is hardcoded there).
# NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
